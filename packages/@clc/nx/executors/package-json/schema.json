{
  "$schema": "http://json-schema.org/schema",
  "version": 2,
  "title": "PackageJson executor",
  "description": "",
  "type": "object",
  "properties": {
    "extraFiles": {
      "description": "Package-root paths to add to the `files` allowlist, beyond the ones implied by `type`.",
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "mjs": {
      "type": "boolean",
      "default": false
    },
    "mts": {
      "type": "boolean",
      "default": false
    },
    "type": {
      "enum": ["cli", "example", "package", "tool"],
      "type": "string",
      "default": "package"
    }
  },
  "required": [],
  "additionalProperties": false
}
